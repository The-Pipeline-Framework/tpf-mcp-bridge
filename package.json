{
  "name": "tpf-author-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Versioned, author-facing TPF knowledge MCP for Cloudflare Workers",
  "license": "Apache-2.0",
  "homepage": "https://github.com/The-Pipeline-Framework/tpf-mcp-bridge",
  "bugs": {
    "url": "https://github.com/The-Pipeline-Framework/tpf-mcp-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Pipeline-Framework/tpf-mcp-bridge.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "audit:release-parity": "tsx scripts/audit-release-parity.ts",
    "check": "npm run format:check && npm run lint && npm run build && npm test",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "dev": "wrangler dev --env staging",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:repowise-upload-hook": "tsx scripts/install-repowise-upload-hook.ts",
    "lint": "oxlint .",
    "migrate:local": "wrangler d1 migrations apply TPF_MCP_KNOWLEDGE --local",
    "migrate:staging": "wrangler d1 migrations apply TPF_MCP_KNOWLEDGE --env staging --remote",
    "migrate:production": "wrangler d1 migrations apply TPF_MCP_KNOWLEDGE --remote",
    "publish:knowledge": "tsx scripts/publish-knowledge.ts",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "upload:repowise-input": "tsx scripts/upload-repowise-input.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.0.0",
    "@cloudflare/workers-types": "5.20260823.1",
    "@types/node": "24.9.0",
    "oxlint": "1.39.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
